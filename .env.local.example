# Database (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NextAuth.js v5
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob (for product image uploads)
# Get from https://vercel.com/dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Admin credentials
ADMIN_EMAIL=admin@lagunaleaf.com
# Generate bcrypt hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))"
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
